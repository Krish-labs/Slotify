# Application
APP_NAME=SchedulAI
APP_ENV=development
DEBUG=true
# Development only: the backend fills this marker automatically when unset.
# Production rejects it at startup; set a real 32+ character secret there.
SECRET_KEY=dev-only-local-insecure-do-not-use-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+asyncpg://schedulai:schedulai@localhost:5432/schedulai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# Authentication hardening
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# auto = Redis when reachable else process-local fallback (dev/tests).
# Use "redis" to require shared state (multi-worker production).
AUTH_STATE_BACKEND=auto
# Local prototype only. Bypasses login/RBAC but never creates a user record.
# Keep false outside a loopback development environment.
LOCAL_AUTH_DISABLED=true
# Optional existing active user used as the local persistence actor.
# LOCAL_AUTH_USER_EMAIL=

# Scheduler
SOLVER_TIME_LIMIT_SECONDS=300
SOLVER_NUM_WORKERS=8

# AI Module
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4
AI_API_BASE_URL=https://api.openai.com/v1

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@schedulai.local

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
