# Production environment template for docker-compose.prod.yml.
# Copy to .env.prod (Git-ignored, never commit it) and fill every value:
#   cp .env.prod.example .env.prod
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# EXISTING DATA WARNING: postgres_data already exists with the development
# password. POSTGRES_PASSWORD is only read on first volume initialization.
# Either reuse the current password for the first production boot, or stop
# the stack, back up with pg_dump, remove the volume, boot with the new
# password, and restore. Do not change the password and reboot against the
# old volume: PostgreSQL will reject every connection.

APP_ENV=production
DEBUG=false

# 32+ random characters. The backend refuses to boot without it.
SECRET_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# Database (private to the compose network; ports are not published).
POSTGRES_DB=schedulai
POSTGRES_USER=schedulai
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://schedulai:CHANGE_ME_DB_PASSWORD@postgres:5432/schedulai

# Redis (password-protected via requirepass; URL must carry the password).
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Explicit trusted origins (scheme + host). No "*", no localhost.
API_CORS_ORIGINS=["https://timetable.example.edu"]

# Frontend origin used in links/emails.
FRONTEND_URL=https://timetable.example.edu

# Password policy for new accounts and seeded admins.
PASSWORD_MIN_LENGTH=12

# Login throttling (shared across workers via Redis).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_STATE_BACKEND=redis

# Optional admin seeding on `make db-seed` (both required together).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
